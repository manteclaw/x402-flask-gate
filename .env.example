# Copy to .env and fill in your own values. Never commit .env.
# WALLET_ADDRESS is the only required variable.

# Wallet that receives USDC payments (required, no default).
# Use a fresh wallet you control — never paste a private key here.
WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Price charged per POST /query call, in USDC.
QUERY_PRICE_USDC=0.03

# Default chain: base (or skale — see server.py CHAINS).
X402_CHAIN=base

# Base RPC endpoint used to verify payments. The public endpoint works
# for testing; use your own Alchemy/QuickNode URL for production.
ALCHEMY_BASE_RPC=https://mainnet.base.org

# Max age (seconds) of a payment transaction before it is rejected.
X402_TX_MAX_AGE=300

# Where the replay-protection store lives (tx hashes already used).
X402_TX_STORE=/tmp/x402_tx_store.json

# Port the server listens on.
PORT=8080

# Name shown in /health and / responses.
AGENT_NAME=x402-flask-gate

# --- Optional: marketplace registration (see README) -----------------------
# If you register the agent on a marketplace that needs a signing wallet
# and IPFS metadata upload, set these two and keep them out of git.
# They are NOT used by server.py itself.
# WALLET_KEY=your-wallet-private-key-here
# PINATA_JWT=your-pinata-jwt-here
